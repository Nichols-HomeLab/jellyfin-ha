# syntax=docker/dockerfile:1
# Runtime-only image — the .NET publish step runs on the CI host (runner),
# not inside this Dockerfile.

# Build the matching Jellyfin Web v12.0 release from an immutable source revision.
FROM --platform=linux/amd64 node:24-bookworm-slim AS webclient
ARG JELLYFIN_WEB_REVISION=0e83c6a724b31f3e9b5a499244331a288c060a4a
WORKDIR /web
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git \
 && git init . \
 && git remote add origin https://github.com/jellyfin/jellyfin-web.git \
 && git fetch --depth=1 origin "${JELLYFIN_WEB_REVISION}" \
 && git checkout --detach FETCH_HEAD \
 && rm -rf /var/lib/apt/lists/* \
 && npm ci --no-audit --no-fund \
 && npm run build:production

# ── Runtime stage ─────────────────────────────────────────────────────────────
FROM --platform=linux/amd64 mcr.microsoft.com/dotnet/aspnet:10.0

# Jellyfin's FFmpeg package pins its FFmpeg/libvpl userspace and bundles a
# compatible Intel iHD VAAPI driver. Keep the package immutable so a base-image
# rebuild cannot silently change the hardware-transcode contract.
ARG JELLYFIN_FFMPEG_VERSION=7.1.4-3-noble
ARG JELLYFIN_BUILD_IDENTITY=unknown

LABEL org.opencontainers.image.revision=${JELLYFIN_BUILD_IDENTITY}

# Install Jellyfin FFmpeg, Intel QSV/VAAPI userspace, and native dependencies
# required by SkiaSharp and fontconfig.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      fontconfig \
      gnupg \
      libfontconfig1 \
      libfreetype6 \
 && curl -fsSL https://repo.jellyfin.org/jellyfin_team.gpg.key \
    | gpg --dearmor -o /usr/share/keyrings/jellyfin.gpg \
 && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/jellyfin.gpg] https://repo.jellyfin.org/ubuntu noble main" \
    > /etc/apt/sources.list.d/jellyfin.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
      jellyfin-ffmpeg7="${JELLYFIN_FFMPEG_VERSION}" \
 && ln -s /usr/lib/jellyfin-ffmpeg/ffmpeg /usr/local/bin/ffmpeg \
 && ln -s /usr/lib/jellyfin-ffmpeg/ffprobe /usr/local/bin/ffprobe \
 && rm -rf /var/lib/apt/lists/*

ENV LIBVA_DRIVER_NAME=iHD \
    JELLYFIN_BUILD_IDENTITY=${JELLYFIN_BUILD_IDENTITY}

COPY scripts/verify-qsv-runtime.sh /usr/local/bin/verify-qsv-runtime
RUN chmod 0755 /usr/local/bin/verify-qsv-runtime \
 && /usr/local/bin/verify-qsv-runtime

WORKDIR /jellyfin

# Copy the pre-built publish output produced by `dotnet publish` on the CI host.
COPY publish-output/ .
# Copy the jellyfin-web client assets from the webclient stage.
COPY --from=webclient /web/dist ./jellyfin-web/

# Jellyfin default ports
EXPOSE 8096
EXPOSE 8920

# Data / config volumes
VOLUME ["/config", "/cache", "/media"]

ENV JELLYFIN_DATA_DIR=/config \
    JELLYFIN_CACHE_DIR=/cache \
    JELLYFIN_LOG_DIR=/config/log \
    JELLYFIN_FFMPEG=/usr/lib/jellyfin-ffmpeg/ffmpeg

# Directory settings are environment-configurable. Do not repeat them as CLI
# arguments here: command-line values override JELLYFIN_*_DIR and make retained
# installations with separate config/data paths fail marker validation.
ENTRYPOINT ["./jellyfin"]
