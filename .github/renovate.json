{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>jellyfin/.github//renovate-presets/dotnet"
  ],
  "packageRules": [
    {
      "description": "Keep Microsoft runtime packages on the .NET 10 major",
      "matchDatasources": [
        "nuget"
      ],
      "matchPackageNames": [
        "/^Microsoft\\.(AspNetCore|Data|EntityFrameworkCore|Extensions)\\./"
      ],
      "allowedVersions": "<11"
    }
  ]
}
